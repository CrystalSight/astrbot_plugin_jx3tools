{
  "general": {
    "type": "object",
    "description": "通用设置",
    "hint": "控制插件开关、JX3API 地址与默认区服。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用查询功能",
        "default": true
      },
      "api_base_url": {
        "type": "string",
        "description": "JX3API 基础地址",
        "hint": "默认使用当前官方服务；仅接受不含路径的 HTTPS 地址，聊天用户不能覆盖。",
        "default": "https://www.jx3api.com"
      },
      "default_server": {
        "type": "string",
        "description": "默认区服",
        "hint": "未提供区服时自动补齐；留空则要求用户填写。",
        "default": ""
      }
    }
  },
  "credentials": {
    "type": "object",
    "description": "JX3API 凭据",
    "hint": "凭据仅按接口需要注入，不会出现在日志、帮助或图片中。",
    "obvious_hint": true,
    "items": {
      "token": {
        "type": "string",
        "description": "JX3API Token",
        "obvious_hint": true,
        "default": ""
      },
      "ticket": {
        "type": "string",
        "description": "推栏 Ticket",
        "hint": "仅阵眼和名剑等需要 Ticket 的接口使用。",
        "obvious_hint": true,
        "default": ""
      }
    }
  },
  "features": {
    "type": "object",
    "description": "功能分组",
    "hint": "按用户可见的免费、会员、其他三类控制。",
    "items": {
      "free_enabled": {
        "type": "bool",
        "description": "启用免费功能",
        "default": true
      },
      "member_enabled": {
        "type": "bool",
        "description": "启用会员功能",
        "default": true
      },
      "other_enabled": {
        "type": "bool",
        "description": "启用其他功能",
        "default": true
      }
    }
  },
  "network": {
    "type": "object",
    "description": "网络与限流",
    "hint": "限制第三方请求占用；所有值还会在代码中执行边界校验。",
    "items": {
      "timeout_seconds": {
        "type": "int",
        "description": "请求总超时（秒）",
        "default": 20
      },
      "max_concurrency": {
        "type": "int",
        "description": "最大并发请求数",
        "default": 4
      },
      "requests_per_minute": {
        "type": "int",
        "description": "每会话每分钟请求数",
        "default": 12
      },
      "max_response_kib": {
        "type": "int",
        "description": "最大响应大小（KiB）",
        "default": 4096
      }
    }
  },
  "presentation": {
    "type": "object",
    "description": "结果展示",
    "hint": "图片在本地使用 Pillow 和持久化目录中的阿里巴巴普惠体生成。",
    "items": {
      "render_mode": {
        "type": "string",
        "description": "渲染模式",
        "hint": "auto 遵循各功能设计；text 尽量使用文字；image 尽量使用图片。骚话、舔狗、解密和开服始终为文字。",
        "options": [
          "auto",
          "text",
          "image"
        ],
        "default": "auto"
      },
      "max_items": {
        "type": "int",
        "description": "普通列表最多展示项目数",
        "hint": "明确要求完整展示的功能不受此项截断。",
        "default": 30
      }
    }
  },
  "push": {
    "type": "object",
    "description": "事件推送",
    "hint": "仅推送到群组配置中登记的目标，与查询开关独立。保存并重载后生效。",
    "items": {
      "server_enabled": {
        "type": "bool",
        "description": "开服状态推送",
        "default": false
      },
      "news_enabled": {
        "type": "bool",
        "description": "官方新闻推送",
        "default": false
      },
      "version_enabled": {
        "type": "bool",
        "description": "版本更新推送",
        "default": false
      }
    }
  },
  "groups": {
    "type": "template_list",
    "description": "群组配置",
    "hint": "最多 200 个群。登记即允许按有效推送开关接收通知；未登记群仅沿用全局查询配置。",
    "default": [],
    "templates": {
      "group": {
        "name": "群组",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "群名称备注",
            "default": ""
          },
          "umo": {
            "type": "string",
            "description": "群 UMO",
            "hint": "格式为 平台实例ID:GroupMessage:群ID；不要填写包含群成员 ID 的隔离会话 UMO。重复或非法目标不推送。",
            "default": ""
          },
          "default_server": {
            "type": "string",
            "description": "默认区服",
            "hint": "填写服务器完整名称；留空继承全局。开服推送精确匹配服务器名称。",
            "default": ""
          },
          "query_enabled": {
            "type": "string",
            "description": "查询功能",
            "options": [
              "继承全局",
              "开启",
              "关闭"
            ],
            "default": "继承全局"
          },
          "free_enabled": {
            "type": "string",
            "description": "免费查询",
            "options": [
              "继承全局",
              "开启",
              "关闭"
            ],
            "default": "继承全局"
          },
          "member_enabled": {
            "type": "string",
            "description": "会员查询",
            "options": [
              "继承全局",
              "开启",
              "关闭"
            ],
            "default": "继承全局"
          },
          "other_enabled": {
            "type": "string",
            "description": "其他查询",
            "options": [
              "继承全局",
              "开启",
              "关闭"
            ],
            "default": "继承全局"
          },
          "push": {
            "type": "object",
            "description": "事件推送",
            "items": {
              "server_enabled": {
                "type": "string",
                "description": "开服状态推送",
                "options": [
                  "继承全局",
                  "开启",
                  "关闭"
                ],
                "default": "继承全局"
              },
              "news_enabled": {
                "type": "string",
                "description": "官方新闻推送",
                "options": [
                  "继承全局",
                  "开启",
                  "关闭"
                ],
                "default": "继承全局"
              },
              "version_enabled": {
                "type": "string",
                "description": "版本更新推送",
                "options": [
                  "继承全局",
                  "开启",
                  "关闭"
                ],
                "default": "继承全局"
              }
            }
          }
        }
      }
    }
  }
}
